# VCS / local environments
.git
.venv
.cursor

# Python noise
__pycache__
**/__pycache__
*.pyc
.pytest_cache
.ruff_cache

# Local runtime database (built fresh inside the image)
data

# Tests and docs are not needed to build or run the app
tests
docs

# Legacy source clones: only shipped packs' data enter the build context.
# Their .git dirs never enter the context.
sources/*/.git
sources/*
!sources/MHFU-ASS
!sources/MHP3-ASS
