# Copy to .env and adjust. Used by docker compose (env_file + ${VAR} substitution)
# and by local `uvicorn` / `python -m app.bootstrap` (pydantic-settings reads .env).

# --- Application (app/config.py) ---

# Docker + SQLite (default dev stack):
DATABASE_URL=sqlite:////data/setseeker.db
# Local venv without Docker (relative path from repo root):
# DATABASE_URL=sqlite:///data/setseeker.db
#
# MariaDB overlay: set MARIADB_* below — compose derives DATABASE_URL from them.
# Do not hand-edit the password in DATABASE_URL; keep MARIADB_PASSWORD in sync.
# If you change MARIADB_PASSWORD after first boot, reset the DB volume:
#   docker compose -f docker-compose.yml -f docker-compose.mariadb.yml down -v

SOLVER_TIME_LIMIT_MS=2000
SOLVER_NUM_WORKERS=8
SOLVER_MAX_INFLIGHT=1
SOLVER_QUEUE_WAIT_S=30.0

# Shown in the page footer; deploy scripts may override per release tag.
SETSEEKER_VERSION=0.1.0

# --- MariaDB container (docker-compose.mariadb.yml) ---

MARIADB_ROOT_PASSWORD=setseeker
MARIADB_DATABASE=setseeker
MARIADB_USER=setseeker
MARIADB_PASSWORD=setseeker

# --- Production deploy / Traefik blue-green ---

# Path to the tagged release tree for bind mounts (production only).
RELEASE_ROOT=.

# Route public HTTP traffic to a slot (deploy script toggles these).
TRAEFIK_ENABLE_BLUE=true
TRAEFIK_ENABLE_GREEN=false

# Base path for releases/ and state/ on the VPS (optional).
# SETSEEKER_DEPLOY_ROOT=/opt/set-seeker

# Set to 1 to redeploy an already-live release tag.
# DEPLOY_FORCE=0
