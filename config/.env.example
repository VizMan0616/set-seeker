# Copy to config/.env and adjust for local or compose deployment.
# pydantic-settings reads this file when present (see app/config.py).

DATABASE_URL=sqlite:///data/setseeker.db

# Per-solve CP-SAT wall clock (milliseconds).
SOLVER_TIME_LIMIT_MS=2000
SOLVER_NUM_WORKERS=8
SOLVER_MAX_INFLIGHT=1
SOLVER_QUEUE_WAIT_S=30.0
